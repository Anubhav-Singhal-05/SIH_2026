# Copy this file to `.env` (or `atlas-credentials.env`) and fill in your own
# Atlas values. NEVER commit the real file — it is git-ignored.
# These are the standard MongoDB Atlas variable names used by both the
# Node layer (database/src/env.js) and the Python tooling
# (database/scripts/populate_dummy_data.py).

MONGODB_USERNAME="your_db_user"
MONGODB_PASSWORD="your_db_password"
MONGODB_URI="mongodb+srv://your_db_user:your_db_password@cluster0.xxxxx.mongodb.net"
MONGODB_DB_NAME="sih26_dev"
